<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>org.herbal3d.convoar</RootNamespace>
    <AssemblyName>convoar</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="log4net" Version="3.0.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="LibreMetaverse" Version="2.6.5" />
    <PackageReference Include="LibreMetaverse.PrimMesher" Version="2.6.5" />
    <PackageReference Include="LibreMetaverse.StructuredData" Version="2.6.5" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!--
      v4 plantait en NU1605 : on pinnait CoreJ2K 1.1.1.48 et
      Microsoft.Extensions.Configuration 8.0.0 alors que
      LibreMetaverse 2.6.5 amène déjà CoreJ2K 2.1.2.38 et
      Microsoft.Extensions.Configuration 9.0.11 en transitif.
      NuGet refuse le downgrade. Donc on NE les repinne PAS ici.
      - CoreJ2K arrive via LibreMetaverse -> CoreJ2K.Skia 2.1.2.38
      - NiniShim.cs n'a besoin d'aucun package Microsoft.Extensions.*,
        c'est un Dictionary en mémoire.
      Si un jour tu as besoin de CoreJ2K en direct, mets 2.1.2.38 ou plus, jamais 1.1.1.48.
    -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\addon-modules\HerbalCommonEntitiesCS\CommonEntitiesConv\Herbal3d.CommonEntitiesConv.csproj" />
    <ProjectReference Include="..\addon-modules\HerbalCommonEntitiesCS\CommonEntities\Herbal3d.CommonEntities.csproj" />
    <ProjectReference Include="..\addon-modules\HerbalCommonUtilCS\Herbal3d.CommonUtil.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>
</Project>
